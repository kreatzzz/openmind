{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the main local window can use the prototype's narrow vault and conversation commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "allow-list-plans",
    "allow-create-plan",
    "allow-remove-plan",
    "allow-enable-plan",
    "allow-get-provider-settings",
    "allow-update-provider-settings",
    "allow-get-reading-settings",
    "allow-update-reading-settings",
    "allow-check-provider-health",
    "allow-list-note-jobs",
    "allow-resume-note-jobs",
    "allow-get-vault-status",
    "allow-create-vault",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-list-sessions",
    "allow-create-session",
    "allow-update-session",
    "allow-list-messages",
    "allow-list-models",
    "allow-list-codex-models",
    "allow-send-message",
    "allow-cancel-turn",
    "allow-open-demo",
    "allow-list-notes",
    "allow-edit-note",
    "allow-delete-note",
    "allow-list-memories",
    "allow-edit-memory",
    "allow-delete-memory",
    "allow-retry-notes",
    "allow-delete-session"
  ]
}
