{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the main local window can use the prototype's narrow vault and conversation commands.",
  "windows": ["main"],
  "permissions": [
    "allow-get-vault-status",
    "allow-create-vault",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-list-sessions",
    "allow-create-session",
    "allow-list-messages",
    "allow-list-models",
    "allow-send-message",
    "allow-cancel-turn"
  ]
}
